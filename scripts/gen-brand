#!/usr/bin/env bash
# Generate the desktop mirror of the engine's single source of product identity.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$ROOT/apps/desktop/src/shared/brand.generated.ts"
python3 - "$ROOT" "$OUT" <<'PY'
import re
import sys
from pathlib import Path
root, out = Path(sys.argv[1]), Path(sys.argv[2])
text = (root / "engine/shorts_engine/common/brand.py").read_text(encoding="utf-8")
def value(name: str) -> str:
    match = re.search(rf"^{name}\s*=\s*(.+)$", text, re.M)
    if not match:
        raise SystemExit(f"{name} not found in engine brand.py")
    return match.group(1).strip()
out.parent.mkdir(parents=True, exist_ok=True)
out.write_text(
    "// Generated by scripts/gen-brand from engine/shorts_engine/common/brand.py.\n"
    "// Do not edit by hand; the engine's brand module is the only source.\n"
    f"export const PRODUCT_NAME = {value('PRODUCT_NAME')}\n"
    f"export const PROTOCOL_VERSION = {value('PROTOCOL_VERSION')}\n",
    encoding="utf-8",
)
print(f"wrote {out}")
PY
