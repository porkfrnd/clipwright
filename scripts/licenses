#!/usr/bin/env python3
"""Generate THIRD_PARTY_LICENSES.md from pinned manifests and installed metadata.

This is a factual inventory, not a legal opinion. It reads:
  * resources/bin/MANIFEST.json (pinned third-party executables)
  * resources/fonts/*.txt (bundled OFL license texts)
  * apps/desktop/package-lock.json (Electron/npm dependency tree)
  * .venv Python package metadata (engine dependencies)
  * engine/shorts_engine/models/catalog.py (downloaded model licenses)
"""
from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PYTHON = ROOT / ".venv/bin/python"
OUT = ROOT / "THIRD_PARTY_LICENSES.md"


def esc(value: object) -> str:
    return str(value or "").replace("|", "\\|").replace("\n", " ")


def python_packages() -> list[dict]:
    code = r"""
import json
from importlib.metadata import distributions
rows = []
for d in distributions():
    meta = d.metadata
    name = meta.get('Name') or 'unknown'
    version = d.version or meta.get('Version') or ''
    lic = meta.get('License-Expression') or meta.get('License') or ''
    if not lic or len(lic) > 120:
        lic = ', '.join(meta.get_all('Classifier') or [])[:300]
    rows.append({'name': name, 'version': version, 'license': lic or 'See package metadata',
                 'home': meta.get('Home-page') or meta.get('Project-URL') or ''})
print(json.dumps(sorted(rows, key=lambda r: r['name'].lower())))
"""
    result = subprocess.run([str(PYTHON), "-c", code], capture_output=True, text=True, check=True)
    return json.loads(result.stdout)


def npm_packages() -> list[dict]:
    lock = json.loads((ROOT / "apps/desktop/package-lock.json").read_text())
    rows = []
    for key, meta in lock.get("packages", {}).items():
        if not key.startswith("node_modules/"):
            continue
        name = meta.get("name") or key.split("node_modules/")[-1]
        rows.append(
            {
                "name": name,
                "version": meta.get("version", ""),
                "license": meta.get("license") or "See package metadata",
                "dev": bool(meta.get("dev")),
                "home": meta.get("homepage") or meta.get("resolved", ""),
            }
        )
    return sorted(rows, key=lambda r: (r["name"].lower(), r["version"]))


def main() -> int:
    manifest = json.loads((ROOT / "resources/bin/MANIFEST.json").read_text())
    fonts = sorted(p.name for p in (ROOT / "resources/fonts").glob("*.ttf"))
    ofl = sorted(p.name for p in (ROOT / "resources/fonts").glob("OFL-*.txt"))
    sys.path.insert(0, str(ROOT / "engine"))
    from shorts_engine.models.catalog import FACE_MODELS, LLM_MODELS, WHISPER_MODELS  # noqa: PLC0415

    py = python_packages()
    npm = npm_packages()
    lines = [
        "# Third-Party Licenses",
        "",
        "Clipwright itself is MIT-licensed (see `LICENSE`). This file inventories the third-party",
        "software, fonts, models and binaries distributed with, or downloaded by, Clipwright.",
        "It is generated by `scripts/licenses` from pinned manifests and installed package metadata.",
        "",
        "> This is not legal advice. Before commercial redistribution, review the GPL obligations",
        "> for FFmpeg, the model licenses, and every dependency flagged below. In particular, the",
        "> bundled FFmpeg build is **GPL-2.0-or-later** because it includes libx264 and libass.",
        "",
        "## Bundled executables",
        "",
        "| Component | Version | License | Source |",
        "| --- | --- | --- | --- |",
    ]
    for platform_name, items in manifest.get("platforms", {}).items():
        for item in items:
            version = item.get("version") or ""
            if not version:
                url = item.get("url", "")
                version = url.rstrip("/").split("/")[-1]
            lines.append(
                f"| {esc(item.get('name'))} ({esc(platform_name)}) | {esc(version)} | "
                f"{esc(item.get('license'))} | {esc(item.get('source') or item.get('url'))} |"
            )
    lines += [
        "",
        "FFmpeg is invoked as a separate executable (`ffmpeg`/`ffprobe`); it is not linked into",
        "Clipwright. The pinned build is the johnvansickle.com static **GPL-2.0-or-later** build",
        "(FFmpeg 7.0.2) and includes libx264 and libass. Corresponding source and build information:",
        "<https://johnvansickle.com/ffmpeg/> and <https://ffmpeg.org/download.html>.",
        "The exact archive URL and SHA-256 are recorded in `resources/bin/MANIFEST.json`.",
        "",
        "yt-dlp is Unlicense. Deno is MIT. The bundled Deno runtime is used only by yt-dlp for",
        "YouTube JavaScript challenges; it is not executed by Clipwright's own code.",
        "",
        "## Fonts (SIL Open Font License 1.1)",
        "",
        "| Font file | License text |",
        "| --- | --- |",
    ]
    for font in fonts:
        lines.append(f"| {esc(font)} | See `resources/fonts/` OFL text |")
    lines += ["", "Bundled OFL license files: " + ", ".join(f"`{name}`" for name in ofl) + ".", ""]

    lines += [
        "## Models downloaded on demand",
        "",
        "| Model | Source / revision | License |",
        "| --- | --- | --- |",
    ]
    for model in WHISPER_MODELS:
        lines.append(
            f"| Whisper {esc(model['name'])} | {esc(model['repo'])} @ `{esc(model['revision'])}` | "
            "MIT (OpenAI Whisper weights, converted by Systran) |"
        )
    for model in FACE_MODELS:
        lines.append(
            f"| {esc(model['label'])} | {esc(model['url'])} | {esc(model['license'])} |"
        )
    for model in LLM_MODELS:
        lines.append(
            f"| {esc(model['label'])} | {esc(model['repo'])} @ `{esc(model['revision'])}` | {esc(model['license'])} |"
        )
    lines += [
        "",
        "Models are downloaded only after the user chooses them, into the user data directory.",
        "Exact SHA-256 pins for the YuNet and Qwen GGUF models and revisions for Whisper are in",
        "`engine/shorts_engine/models/catalog.py`. The local runtime is llama-cpp-python (MIT).",
        "",
        "## Electron runtime",
        "",
        "| Component | Version | License |",
        "| --- | --- | --- |",
        "| Electron | 45.4.1 | MIT |",
        "| Chromium (inside Electron) | 156.0.8078.100 (as reported by the app) | BSD-style and others; see Electron's `LICENSES.chromium.html` in the packaged app |",
        "| Node.js (inside Electron) | 24.22.3 (as reported by the app) | MIT |",
        "",
        "## npm dependencies",
        "",
        "The table lists every package in `apps/desktop/package-lock.json`.",
        "",
        "| Package | Version | License | Dev |",
        "| --- | --- | --- | --- |",
    ]
    for row in npm:
        lines.append(
            f"| {esc(row['name'])} | {esc(row['version'])} | {esc(row['license'])} | "
            f"{'yes' if row['dev'] else 'no'} |"
        )

    lines += [
        "",
        "## Python dependencies (engine virtualenv)",
        "",
        "Licenses below come from each installed distribution's metadata. When the metadata",
        "does not declare a license, the entry says so instead of guessing.",
        "",
        "| Package | Version | License |",
        "| --- | --- | --- |",
    ]
    for row in py:
        lines.append(f"| {esc(row['name'])} | {esc(row['version'])} | {esc(row['license'])} |")

    lines += [
        "",
        "## Test fixtures",
        "",
        "`tests/fixtures/demo-lecture.mp4` and `tests/fixtures/src/*.wav` were generated for this",
        "project using FFmpeg and the `flite` speech synthesizer. They contain no third-party",
        "footage or music. See `tests/fixtures/ATTRIBUTION.md`.",
        "",
        "## Review checklist before shipping",
        "",
        "- [ ] Legal review of GPL FFmpeg redistribution and the corresponding-source offer.",
        "- [ ] Confirm the licenses of Python wheels shipped inside the frozen engine, especially",
        "      ctranslate2, onnxruntime, PyAV/FFmpeg bindings, OpenCV and NumPy.",
        "- [ ] Keep the OFL texts and model license notices with the installer.",
        "- [ ] Re-run `scripts/licenses` after dependency or binary updates.",
        "",
    ]
    OUT.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"wrote {OUT.relative_to(ROOT)} ({len(npm)} npm packages, {len(py)} Python packages)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
