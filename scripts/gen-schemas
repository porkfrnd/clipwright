#!/usr/bin/env python3
"""Generate protocol JSON Schema and TypeScript request/response types.

The Python Pydantic models are authoritative. The desktop mirror is generated so
it cannot drift. Refuses to run if the product name/protocol copy is stale.
"""
from __future__ import annotations

import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
import importlib.util

if importlib.util.find_spec("pydantic") is None:
    venv = ROOT / ".venv/bin/python"
    if venv.exists():
        __import__("os").execv(str(venv), [str(venv), *sys.argv])
    print("Run this script with the project virtualenv (missing pydantic).", file=sys.stderr)
    raise SystemExit(2)
sys.path.insert(0, str(ROOT / "engine"))

from shorts_engine.api import registry  # noqa: E402
from shorts_engine.api.methods import analysis, projects, providers, render, system  # noqa: E402
from shorts_engine.api.schemas import ErrorPayload, Event, Request, Response  # noqa: E402
from shorts_engine.common.brand import PROTOCOL_VERSION, PRODUCT_NAME  # noqa: E402

OUT = ROOT / "schemas"
TS_OUT = ROOT / "apps/desktop/src/shared/schemas.generated.ts"


def parse_ts_brand(path: Path) -> dict[str, str]:
    text = path.read_text(encoding="utf-8")
    return dict(re.findall(r'export const (\w+) = "?([^"\n]+)"?', text))


def main() -> int:
    brand = parse_ts_brand(ROOT / "apps/desktop/src/shared/brand.generated.ts")
    if brand.get("PRODUCT_NAME") != PRODUCT_NAME or int(brand.get("PROTOCOL_VERSION", "0")) != PROTOCOL_VERSION:
        print("brand.generated.ts is stale; run scripts/gen-brand first", file=sys.stderr)
        return 1

    reg = registry.Registry()
    for module in (system, projects, providers, analysis, render):
        module.register(reg)

    schemas: dict[str, dict] = {}
    methods: dict[str, str] = {}
    for name, (model, _handler) in sorted(reg.routes.items()):
        schema = model.model_json_schema(by_alias=True)
        schemas[model.__name__] = schema
        methods[name] = model.__name__
    for model in (Request, Response, Event, ErrorPayload):
        schemas[model.__name__] = model.model_json_schema(by_alias=True)

    protocol = {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": f"{PRODUCT_NAME} engine protocol v{PROTOCOL_VERSION}",
        "protocolVersion": PROTOCOL_VERSION,
        "methods": methods,
        "$defs": schemas,
    }
    OUT.mkdir(parents=True, exist_ok=True)
    (OUT / "protocol.schema.json").write_text(json.dumps(protocol, indent=2) + "\n", encoding="utf-8")
    (OUT / "methods.json").write_text(json.dumps(methods, indent=2) + "\n", encoding="utf-8")

    def ts_type(schema: dict, indent: int = 0) -> str:
        if "$ref" in schema:
            return schema["$ref"].split("/")[-1]
        if "anyOf" in schema:
            return " | ".join(ts_type(item, indent) for item in schema["anyOf"]) or "unknown"
        if "enum" in schema:
            return " | ".join(json.dumps(value) for value in schema["enum"])
        kind = schema.get("type")
        if kind == "object":
            props = schema.get("properties") or {}
            required = set(schema.get("required") or [])
            if not props:
                return "Record<string, unknown>"
            pad = "  " * (indent + 1)
            lines = ["{"]
            for key, value in props.items():
                optional = "" if key in required else "?"
                lines.append(f"{pad}{json.dumps(key)}{optional}: {ts_type(value, indent + 1)};")
            lines.append("  " * indent + "}")
            return "\n".join(lines)
        if kind == "array":
            return f"{ts_type(schema.get('items') or {}, indent)}[]"
        if kind in ("integer", "number"):
            return "number"
        if kind == "boolean":
            return "boolean"
        if kind == "string":
            return "string"
        if kind == "null":
            return "null"
        return "unknown"

    lines = [
        "// Generated by scripts/gen-schemas from engine/shorts_engine/api/params.py.",
        "// Do not edit by hand. The Python Pydantic models are authoritative.",
        f"export const PROTOCOL_VERSION = {PROTOCOL_VERSION}",
        "",
    ]
    for name, schema in schemas.items():
        body = ts_type(schema)
        if schema.get("type") == "object" and (schema.get("properties") or {}):
            lines.append(f"export interface {name} {body}")
        else:
            lines.append(f"export type {name} = {body}")
        lines.append("")
    lines.append("export interface MethodParams {")
    for method, model in methods.items():
        lines.append(f"  {json.dumps(method)}: {model}")
    lines.append("}")
    lines.append("")
    TS_OUT.write_text("\n".join(lines), encoding="utf-8")
    print(f"wrote {OUT / 'protocol.schema.json'}, {OUT / 'methods.json'}, {TS_OUT}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
